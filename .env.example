# Copy to `.env` and adjust. Local development values only — never commit `.env`.

# Postgres warehouse
POSTGRES_USER=rail
POSTGRES_PASSWORD=rail
POSTGRES_DB=warehouse
POSTGRES_PORT=5432

# MinIO data lake
MINIO_ROOT_USER=railfall
MINIO_ROOT_PASSWORD=railfall-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Railfall application settings (see src/railfall/config.py). The pipelines run
# as the least-privilege identities Terraform creates below, never as admin.
LAKE_ENDPOINT_URL=http://localhost:9000
LAKE_BUCKET=railfall-lake
LAKE_ACCESS_KEY=railfall-pipeline
LAKE_SECRET_KEY=railfall-pipeline-secret
WAREHOUSE_DSN=postgresql://railfall_loader:loader-local@localhost:5432/warehouse
# Météo-France departments to ingest (INSEE codes, comma-separated).
METEO_DEPARTMENTS=75,69,13

# Airflow (`make airflow`). AIRFLOW_DB_PASSWORD must equal
# TF_VAR_airflow_db_password: Terraform creates the role, Airflow logs in with it.
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow-local
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
AIRFLOW_WEB_PORT=8080
AIRFLOW_UID=50000
# Leave empty locally; set a generated key anywhere connections hold secrets.
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=railfall-local-only

# Terraform inputs (infra/terraform). Admin credentials mirror the stack above;
# the lake/warehouse role secrets are what the pipelines will connect with.
TF_VAR_minio_root_user=railfall
TF_VAR_minio_root_password=railfall-secret
TF_VAR_lake_pipeline_secret=railfall-pipeline-secret
TF_VAR_postgres_admin_user=rail
TF_VAR_postgres_admin_password=rail
TF_VAR_warehouse_loader_password=loader-local
TF_VAR_warehouse_transformer_password=transformer-local
TF_VAR_warehouse_reader_password=reader-local
# Airflow metadata database (its own database and role on the same server).
TF_VAR_airflow_db_password=airflow-local
